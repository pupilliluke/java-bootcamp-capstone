<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.capstone</groupId>
  <artifactId>crm-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>crm-backend</name>
  <properties>
    <java.version>21</java.version>
    <dependency-check.version>10.0.4</dependency-check.version>
    <tomcat.version>10.1.59</tomcat.version>

    <!-- ContainerImageIT tests a built Docker image, so it needs one to exist.
         The ordinary build has no reason to have built it, and a test that
         cannot run must not be the thing that reddens `mvn verify` on a laptop
         with Docker closed. It is therefore excluded by default and switched on
         by -Pimage-tests, which is what the image job in CI runs once the image
         has actually been built. Excluded here rather than skipped inside the
         test: when it does run, it fails loudly on a missing image rather than
         passing quietly, and that distinction only survives if the decision to
         run it is made outside the test. -->
    <failsafe.excluded.tests>**/ContainerImageIT.java</failsafe.excluded.tests>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Flyway 10+ moved Postgres support into its own module; without this the
         migration fails at startup with "Unsupported Database: PostgreSQL". -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Lab 28's starter carries this as a TODO ("pin a JWT library (e.g. jjwt)
         for production-like signing") and its GUIDE puts real HS256 on the full
         path. The labs never got past the lab.<sub>.<role>.<sig> stub. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.11.5</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.11.5</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.11.5</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Verifies Google Sign-In ID tokens: checks the RS256 signature against
         Google's rotating public keys, the issuer, exp, and that the audience is
         our OAuth client id. Carries GoogleIdTokenVerifier plus the HTTP
         transport and Gson JSON factory it needs. Version pinned; Spring Boot's
         BOM does not manage these coordinates. -->
    <dependency>
      <groupId>com.google.api-client</groupId>
      <artifactId>google-api-client</artifactId>
      <version>2.7.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-scope only. Lets every @SpringBootTest start without Docker or a
         running Postgres; the real schema is exercised by AppUserRepositoryIT. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Drives the container tests in ContainerImageIT: starts the built image
         against a throwaway PostgreSQL and talks to it over HTTP. The postgresql
         module pulls Testcontainers core and the docker-java client with it, so
         it is the only coordinate needed. Version comes from Spring Boot's BOM,
         which manages testcontainers-bom. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-versions</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>This project builds on JDK 21. Spring Boot 3.3.x is tested against Java 17-22, and the team is standardized on Temurin 21.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                  <message>Use Maven 3.9 or newer. The bundled wrapper (./mvnw) already satisfies this.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>${failsafe.excluded.tests}</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The container tests. Run once the image has been built, never before:
         build it with docker (passing GIT_SHA as a build argument) and tag it
         crm-api:test, then `./mvnw verify -Pimage-tests`. The image job in
         .github/workflows/ci.yml does exactly that, in that order.

         This flips the property rather than redeclaring includes and excludes,
         because Maven merges plugin configuration between the base build and a
         profile, and the merge rules for lists are their own small source of
         surprise. Overriding one property has no such ambiguity.

         Setting the crm.image system property points the same assertions at any
         other tag, which is how you check what a registry actually holds rather
         than what happened to be built on this machine. -->
    <profile>
      <id>image-tests</id>
      <properties>
        <failsafe.excluded.tests>nothing-is-excluded-under-this-profile</failsafe.excluded.tests>
      </properties>
    </profile>
    <profile>
      <id>security-scan</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <configuration>
              <formats><format>HTML</format><format>JSON</format></formats>
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <!-- OSS Index needs a Sonatype account. Unauthenticated it returns
                   401, and the analyzer turns that into an AnalysisException that
                   fails the build for a reason unrelated to any vulnerability -
                   a gate that goes red because a third party rate-limited us is
                   not a gate. NVD is the primary source and needs no account. -->
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
              <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
              <outputDirectory>${project.basedir}/../reports</outputDirectory>
            </configuration>
            <executions><execution><goals><goal>check</goal></goals></execution></executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
