# Template for .env.cluster — the per-student values for the course cluster.
#
# Copy this file to the repository root as `.env.cluster` and fill it from
# YOUR row of the credentials sheet. The root .gitignore's `.env.*` rule
# keeps the real file out of the repository; this template records which
# keys exist, exactly like k8s/examples/secret.example.yaml does for the
# Secret. Never commit the filled copy.
#
# `bash k8s/cluster-deploy.sh` reads it and deploys into your namespace:
# same manifests for everyone, your values injected at apply time.

# Namespace = DB user = DB schema; the sheet uses one name for all three.
STUDENT_NS=studentNN

# The course host (swe2). swe1 cohorts use a different IP.
CLUSTER_HOST=100.22.136.97

# Absolute path with FORWARD slashes, no spaces. Windows kubectl accepts
# forward slashes, and backslashes do not survive being sourced by bash
# (C:\Users becomes C:Users), after which kubectl silently falls back to
# localhost:8080 -- the failure the deploy plan warns about.
KUBECONFIG_PATH=C:/Users/<you>/.kube/studentNN.yaml

# From the credentials sheet.
LOCAL_DB_PASSWORD=<sheet>

# 32+ characters (HS256 needs a 256-bit key). Generate one:
#   openssl rand -base64 36
# Only used when the Secret is first created; rotating means deleting the
# Secret and re-running the script, then restarting the deployment.
JWT_SECRET=<generate>

# nip.io resolves <anything>.<ip>.nip.io to <ip> with no DNS setup, and
# Traefik routes on the Host header — so every student can mint a hostname.
INGRESS_HOST=crm-studentNN.100.22.136.97.nip.io

# The published digest to deploy — a digest, not a tag, so what runs is the
# build that was verified. Take it from the publish job's run summary, and
# record it in docs/rollback-runbook.md before deploying.
IMAGE=ghcr.io/pupilliluke/crm-api@sha256:<digest>
