# Copy to .env.local to override the API base URL.
# Leave empty to use the Vite dev proxy (/api -> localhost:8080).
VITE_API_BASE_URL=

# Google Sign-In OAuth client id. Public (it ships in the built bundle), so
# src/config.ts already carries a working default; set this only to point the
# frontend at a different Google project. Must match the backend's GOOGLE_CLIENT_ID.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
