# Build output
target/
*.class
*.jar
*.war

# Frontend
node_modules/
dist/
.vite/
*.tsbuildinfo
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/

# IDE
.idea/
*.iml
.vscode/
.history/

# Secrets and local environment
.env
.env.*
!.env.example
# Belt and braces for local secret directories, in case anyone adds one.
# Anchored: a bare "secrets/" would match any directory of that name anywhere.
/secrets/
/backend/secrets/
*.pem
*.key
*.p12
kubeconfig
*.kubeconfig

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Working notes that are not part of the deliverable. Anything in docs/ itself
# is shared with the team; this is the scratch space beside it.
docs/local/

# Logs and OS
*.log
.DS_Store
Thumbs.db

# Playwright-generated output
frontend/playwright-report/
frontend/test-results/
# Dependency-Check writes its HTML and JSON reports here. They are evidence, not
# source: regenerate them from a scan rather than committing a snapshot that
# stops matching the dependencies the moment anyone edits the pom.
/reports/*
!/reports/.gitkeep
