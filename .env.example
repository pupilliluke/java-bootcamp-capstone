# Copy to .env at the repository root and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
#   cmd:         copy .env.example .env
#
# .env is gitignored. This file is the committed record of WHICH keys exist,
# never of their values.
#
# Both Docker Compose and Spring read .env, so these keys define the local
# container and the application's connection to it. Nothing about either
# database is committed.
#
# A deployed environment has no .env and supplies the same names as real
# environment variables instead. Deploying means copying the keys below into the
# host's settings, not shipping this file.

# --- Required, always ---

# Signs and verifies JWT access tokens. At least 32 characters: HS256 needs a
# 256-bit key and the app refuses to start on anything shorter. Any value works
# locally and it need not match what teammates use, but changing it invalidates
# every token already issued.
JWT_SECRET=change-me-to-at-least-32-characters

# --- Required for the local profile, which is the default ---

# These define the docker-compose container as well as the connection to it.
# Any values work as long as the three agree with each other.
#
# Changing the password after the volume already exists needs
# `docker compose down -v` first: Postgres only applies POSTGRES_PASSWORD when
# it initialises an empty data directory, so an edit alone leaves the old one in
# place and the application then fails to authenticate.
LOCAL_DB_NAME=crm
LOCAL_DB_USER=crm
LOCAL_DB_PASSWORD=change-me
# LOCAL_DB_HOST=localhost
# LOCAL_DB_PORT=5432

# --- Required only for the azure profile ---

# Activate the profile rather than editing any yml:
#   PowerShell: $env:SPRING_PROFILES_ACTIVE = "azure"
#   cmd:        set "SPRING_PROFILES_ACTIVE=azure"
#
# Notes for Azure Database for PostgreSQL Flexible Server:
#   - sslmode=require is added by the azure profile; do not add it here
#   - AZURE_DB_USER is the plain admin name with no @servername suffix, which
#     belonged to the retired Single Server product
#
# AZURE_DB_HOST=<server>.postgres.database.azure.com
# AZURE_DB_NAME=crm
# AZURE_DB_USER=<admin-user>
# AZURE_DB_PASSWORD=<password>
# AZURE_DB_PORT=5432

# --- Optional ---

# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Google Sign-In OAuth 2.0 Web-application client id. NOT a secret — it also
# ships in the frontend bundle — so application.yml carries a working default and
# this only needs setting to point at a different Google project. Must match the
# frontend's VITE_GOOGLE_CLIENT_ID and the "Authorized JavaScript origins" of the
# OAuth client in Google Cloud Console.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
